{
  "name": "notesphere-backend",
  "version": "1.0.0",
  "description": "Backend API for NoteSphere – Smart Academic Resource Sharing Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:auth": "node tests/authTest.js",
    "test:resources": "node tests/resourceTest.js",
    "test:interaction": "node tests/interactionTest.js",
    "test:admin": "node tests/adminIntegrationTest.js",
    "test:security": "node tests/adminSecurityAudit.js",
    "test:master": "node tests/finalMasterEndToEndTest.js",
    "test": "node tests/authTest.js && node tests/resourceTest.js && node tests/interactionTest.js && node tests/adminIntegrationTest.js && node tests/finalMasterEndToEndTest.js",
    "seed:users": "node utils/seedUsers.js",
    "seed:resources": "node utils/seedResources.js",
    "seed:faculty": "node scripts/seedFaculty.js",
    "seed": "node utils/seedUsers.js && node utils/seedResources.js",
    "admin:create": "node utils/createAdmin.js"
  },
  "keywords": [
    "notesphere",
    "mern",
    "express",
    "mongodb",
    "education"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.2",
    "multer-storage-cloudinary": "^4.0.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
